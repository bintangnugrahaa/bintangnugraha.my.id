---
import ProjectCard from "./project-card.astro";
import projectsData from "../data/projects.json";
---

<section id="projects" class="py-4 md:py-20 px-4 md:px-0 overflow-hidden">
  <div class="container mx-auto">
    <div class="mb-16">
      <h2
        class="text-3xl md:text-4xl font-heading font-bold text-white mb-2 flex items-center gap-4"
      >
        <span class="text-accent">/</span> Featured Projects
      </h2>
      <p class="text-gray font-body text-sm max-w-md">
        A curated selection of professional work, published applications, and
        experimental prototypes.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {projectsData.map((project) => <ProjectCard project={project} />)}
    </div>
  </div>
</section>

<script>
  const initProjectReveal = () => {
    const cards = document.querySelectorAll(".project-card");

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          // Trigger only when the card is at least 15% visible in the viewport
          if (entry.isIntersecting) {
            const card = entry.target as HTMLElement;
            const index = Array.from(cards).indexOf(card);

            // Apply a staggered reveal effect based on the card's grid position
            setTimeout(
              () => {
                card.classList.add("reveal");
              },
              (index % 3) * 150,
            );

            observer.unobserve(card);
          }
        });
      },
      {
        threshold: 0.15, // 15% visibility threshold
        rootMargin: "0px 0px -10px 0px", // Negative margin ensures the element is slightly inside the viewport before triggering
      },
    );

    cards.forEach((card) => observer.observe(card));
  };

  // Initialize the reveal effect only after all resources (images, styles) have fully loaded
  window.addEventListener("load", initProjectReveal);

  // Maintain support for Astro View Transitions during client-side navigation
  document.addEventListener("astro:after-swap", initProjectReveal);
</script>

<style>
  /* Initial hidden state of the project card */
  .project-card {
    transform: translateY(20px) scale(0.95);
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Fully revealed state of the project card */
  .project-card.reveal {
    opacity: 1 !important;
    transform: translateY(0) scale(1);
  }
</style>
