---
---

<div class="flex items-center">
  <button
    id="like-btn"
    type="button"
    class="group relative w-40 h-10 flex items-center justify-center p-3 rounded-full transition-all duration-300 ease-in-out transform border-2 border-[var(--white-icon)] hover:scale-105 hover:border-[var(--white)] cursor-pointer"
  >
    <svg
      id="like-heart-icon"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="currentColor"
      class="w-6 h-6 transition-all duration-300 ease-in-out text-[var(--white-icon)] group-hover:text-[var(--white)] group-hover:scale-105"
      aria-hidden="true"
    >
      <path
        d="M16.5 3C19.5376 3 22 5.5 22 9C22 16 14.5 20 12 21.5C9.5 20 2 16 2 9C2 5.5 4.5 3 7.5 3C9.35997 3 11 4 12 5C13 4 14.64 3 16.5 3ZM12.9339 18.6038C13.8155 18.0485 14.61 17.4955 15.3549 16.9029C18.3337 14.533 20 11.9435 20 9C20 6.64076 18.463 5 16.5 5C15.4241 5 14.2593 5.56911 13.4142 6.41421L12 7.82843L10.5858 6.41421C9.74068 5.56911 8.5759 5 7.5 5C5.55906 5 4 6.6565 4 9C4 11.9435 5.66627 14.533 8.64514 16.9029C9.39 17.4955 10.1845 18.0485 11.0661 18.6038C11.3646 18.7919 11.6611 18.9729 12 19.1752C12.3389 18.9729 12.6354 18.7919 12.9339 18.6038Z"
      ></path>
    </svg>
    <span id="like-count-text" class="text-sm pl-3 font-medium text-[var(--white)]">
      0 Likes
    </span>
  </button>
</div>

<script>
  function setupLikeButton() {
    const btn = document.getElementById("like-btn") as HTMLButtonElement | null;
    const heart = document.getElementById("like-heart-icon");
    const countText = document.getElementById("like-count-text");
    if (!btn || !heart || !countText) return;

    let likes = 0;
    let isLiked = localStorage.getItem("websiteIsLiked") === "true";
    let isProcessing = false;

    function applyLikedState() {
      if (isLiked) {
        btn?.classList.remove(
          "border-[var(--white-icon)]",
          "hover:scale-105",
          "hover:border-[var(--white)]",
          "cursor-pointer"
        );
        btn?.classList.add("border-[var(--sec)]", "cursor-default");
        heart?.classList.remove(
          "text-[var(--white-icon)]",
          "group-hover:text-[var(--white)]",
          "group-hover:scale-105"
        );
        heart?.classList.add("text-[var(--sec)]", "scale-110");
        if (btn) btn.disabled = true;
      }
    }

    function updateDisplay(newCount: number) {
      likes = newCount;
      countText!.textContent = `${likes} Likes`;
    }

    if (isLiked) {
      applyLikedState();
    }

    let initialized = false;
    let updateDocFn: any;
    let incrementFn: any;
    let likeDocRef: any;

    async function initFirebase() {
      if (initialized) return;
      initialized = true;

      try {
        const { doc, onSnapshot, updateDoc, increment } = await import(
          "firebase/firestore"
        );
        const { db } = await import("../firebase");

        updateDocFn = updateDoc;
        incrementFn = increment;
        likeDocRef = doc(db, "likes", "counter");

        onSnapshot(likeDocRef, (docSnap: any) => {
          if (docSnap.exists()) {
            const currentLikes = docSnap.data().likes;
            updateDisplay(Math.max(0, currentLikes));
          }
        });
      } catch (err) {
        console.error("Firebase init error:", err);
      }
    }

    btn.addEventListener("click", async () => {
      if (isProcessing || isLiked) return;

      const prevLikes = likes;
      updateDisplay(likes + 1);
      isLiked = true;
      applyLikedState();
      btn.classList.add("animate-heart-pulse");
      setTimeout(() => btn.classList.remove("animate-heart-pulse"), 600);
      localStorage.setItem("websiteIsLiked", "true");

      try {
        isProcessing = true;
        if (!initialized) {
          await initFirebase();
        }
        if (updateDocFn && likeDocRef) {
          await updateDocFn(likeDocRef, {
            likes: incrementFn(1),
          });
        }
      } catch (error) {
        console.error("Error updating likes:", error);
        updateDisplay(prevLikes);
        isLiked = false;
        localStorage.removeItem("websiteIsLiked");
        btn.disabled = false;
        btn.classList.remove("border-[var(--sec)]", "cursor-default");
        btn.classList.add(
          "border-[var(--white-icon)]",
          "hover:scale-105",
          "hover:border-[var(--white)]",
          "cursor-pointer"
        );
        heart.classList.remove("text-[var(--sec)]", "scale-110");
        heart.classList.add(
          "text-[var(--white-icon)]",
          "group-hover:text-[var(--white)]",
          "group-hover:scale-105"
        );
      } finally {
        isProcessing = false;
      }
    });

    const observer = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) {
        observer.disconnect();
        initFirebase();
      }
    });
    observer.observe(btn);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupLikeButton, {
      once: true,
    });
  } else {
    setupLikeButton();
  }
</script>
